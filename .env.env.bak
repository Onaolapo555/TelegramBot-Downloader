# --- Telegram ---
BOT_TOKEN=8643841567:AAGurKJQ4orJ4AfTlbLLRpIVE4FMordTBH8
BOT_API_ID=12345
BOT_API_HASH=your_api_hash_from_my.telegram.org
USE_LOCAL_BOT_API=false
LOCAL_BOT_API_URL=http://telegram-bot-api:8081

# --- Webhook (production) ---
USE_WEBHOOK=false
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_SECRET=random-secret-string-32chars
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
USE_QUEUE=false

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# --- Storage Fallback (R2 / S3 / B2) for >2GB or when Local API fails ---
USE_R2_FALLBACK=false
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=unimedia-temp
R2_PUBLIC_URL=https://temp.yourdomain.com
R2_EXPIRE_SECONDS=3600

# --- App ---
LOG_LEVEL=INFO
MAX_CONCURRENT_DOWNLOADS=3
MAX_DOWNLOADS_PER_USER_PER_HOUR=100
DOWNLOAD_DIR=./data/downloads
COOKIES_DIR=./data/cookies
TMP_CLEANUP_SECONDS=600
ALLOW_PLAYLIST=false
PLAYLIST_MAX_ITEMS=5

# --- Phase-3: Large File & Reliability ---
AUTO_DOWNGRADE_LARGE_FILES=true
LARGE_FILE_THRESHOLD_BYTES=1990000000

# --- Phase-4: Admin / Monetize ---
ADMIN_USER_IDS=[8630862647]
DONATE_URL=
DONATE_TEXT=Support UniMedia

# --- Phase-5: Observability & Advanced ---
SENTRY_DSN=
ENABLE_METRICS=true
ENABLE_SUBTITLES=false
SUBTITLE_LANGS=en
YTDLP_PROXY=
YTDLP_AUTO_UPDATE=true
YTDLP_AUTO_UPDATE_INTERVAL_HOURS=6

# --- Phase-5.1: Insane Speed ---
USE_ARIA2=true
FAST_MODE=true
PROBE_CACHE_TTL=900
ARIA2C_MAX_CONNECTIONS=16

# --- DB Lightweight ---
JOB_RETENTION_DAYS=7
JOB_CLEANUP_INTERVAL_SECONDS=3600
FILE_RETENTION_SECONDS=600


