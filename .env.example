# --- Telegram ---
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
BOT_API_ID=12345
BOT_API_HASH=your_api_hash_from_my.telegram.org
# For Local Bot API Server (allows 2GB files)
USE_LOCAL_BOT_API=false
LOCAL_BOT_API_URL=http://telegram-bot-api:8081

# --- Webhook (production) ---
USE_WEBHOOK=false
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_SECRET=random-secret-string-32chars
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# --- Redis ---
REDIS_URL=redis://redis:6379/0
# For local dev without docker: redis://localhost:6379/0
USE_QUEUE=false
# Set true when running workers (docker-compose) — enqueues downloads to Redis queue.
# false = direct download in bot process (simple polling dev)

# --- Database ---
# Postgres (production): postgresql+asyncpg://user:pass@postgres:5432/unimedia
# SQLite (quick dev): sqlite+aiosqlite:///./data/bot.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/unimedia

# --- Storage Fallback (R2 / S3 / B2) for >2GB or when Local API fails ---
USE_R2_FALLBACK=false
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=unimedia-temp
R2_PUBLIC_URL=https://temp.yourdomain.com
R2_EXPIRE_SECONDS=3600

# --- App ---
LOG_LEVEL=INFO
MAX_CONCURRENT_DOWNLOADS=3
MAX_DOWNLOADS_PER_USER_PER_HOUR=20
DOWNLOAD_DIR=./data/downloads
COOKIES_DIR=./data/cookies
TMP_CLEANUP_SECONDS=600
ALLOW_PLAYLIST=false
PLAYLIST_MAX_ITEMS=5

# --- Phase-3: Large File & Reliability ---
AUTO_DOWNGRADE_LARGE_FILES=true
LARGE_FILE_THRESHOLD_BYTES=1990000000
# auto-downgrade estimated >1.9GB to smaller quality to avoid Telegram 2GB failure
# set false to always keep requested quality (will use R2 if configured, else error)
